/* The window's look: the same colours as the web interface (static/style.css). */
* { color: #e6e9ee; font-size: 13px; }
QMainWindow, QDialog, QWidget#central { background: #111418; }
QWidget#sidebar { background: #111418; border-right: 1px solid #2c323b; }
QSplitter::handle { background: #2c323b; width: 1px; }

QLabel#brand { font-size: 17px; font-weight: 700; }
QLabel#sectionTitle { color: #8b94a3; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
QLabel#muted, QLabel#small { color: #8b94a3; }
QLabel#small { font-size: 12px; }
QLabel#error { color: #ef5350; }
QLabel#printerName { font-weight: 700; }
QLabel#fileName { font-size: 15px; font-weight: 700; }
QLabel#statName { color: #8b94a3; font-size: 10px; letter-spacing: 1px; }
QLabel#pin { font-size: 26px; font-weight: 700; letter-spacing: 6px; }
QLabel#mono { font-family: monospace; color: #8b94a3; }
QLabel#badge { background: #1d3557; color: #9cc5ff; border-radius: 10px; padding: 2px 10px; font-size: 12px; }

QFrame#printerCard { background: #191d23; border: 1px solid #2c323b; border-radius: 8px; }
QWidget#fileHeader, QWidget#infoBar, QWidget#sliderRow { background: #111418; }
QWidget#fileHeader { border-bottom: 1px solid #2c323b; }
QWidget#infoBar { border-top: 1px solid #2c323b; }

QPushButton { background: #191d23; border: 1px solid #2c323b; border-radius: 6px; padding: 6px 12px; }
QPushButton:hover { border-color: #3b8cff; }
QPushButton:disabled { color: #5a6270; border-color: #232830; }
QPushButton#primary { background: #3b8cff; border-color: #3b8cff; color: white; font-weight: 600; }
QPushButton#primary:disabled { background: #22324a; border-color: #22324a; color: #6f7c90; }
QPushButton#danger { color: #ef5350; }
QPushButton#ghost { background: transparent; border: none; color: #8b94a3; padding: 4px 6px; }
QPushButton#ghost:hover { color: #e6e9ee; }
QPushButton#link { background: transparent; border: none; color: #3b8cff; padding: 0 0 0 6px; font-size: 12px; }
QPushButton#link:hover { color: #9cc5ff; }
QPushButton#drop { background: transparent; border: 1px dashed #2c323b; color: #8b94a3; padding: 12px; font-size: 12px; }
QPushButton#drop:hover { border-color: #3b8cff; color: #e6e9ee; }

QLineEdit, QComboBox, QListWidget { background: #191d23; border: 1px solid #2c323b; border-radius: 6px; padding: 6px; }
QLineEdit:focus, QComboBox:focus { border-color: #3b8cff; }
QComboBox QAbstractItemView { background: #191d23; selection-background-color: #22324a; }
QListWidget#files { background: transparent; border: none; }
QListWidget#files::item { padding: 6px; border-radius: 6px; }
QListWidget#files::item:selected { background: #1b2635; border: 1px solid #3b8cff; }
QListWidget#files::item:hover { background: #191d23; }

QProgressBar { background: #0d1014; border: none; border-radius: 3px; }
QProgressBar::chunk { background: #3b8cff; border-radius: 3px; }
QProgressBar#upload::chunk { background: #3ccf7a; }

QTabBar::tab { background: transparent; color: #8b94a3; padding: 6px 14px; border: 1px solid #2c323b; }
QTabBar::tab:first { border-top-left-radius: 6px; border-bottom-left-radius: 6px; }
QTabBar::tab:last { border-top-right-radius: 6px; border-bottom-right-radius: 6px; }
QTabBar::tab:selected { background: #3b8cff; color: white; border-color: #3b8cff; }

QSlider::groove:horizontal { height: 6px; background: #0d1014; border-radius: 3px; }
QSlider::sub-page:horizontal { background: #3b8cff; border-radius: 3px; }
QSlider::handle:horizontal { background: #3b8cff; width: 16px; margin: -5px 0; border-radius: 8px; }

QStatusBar { background: #111418; color: #8b94a3; border-top: 1px solid #2c323b; }
QScrollBar:vertical { background: transparent; width: 8px; }
QScrollBar::handle:vertical { background: #2c323b; border-radius: 4px; }
QToolTip { background: #191d23; color: #e6e9ee; border: 1px solid #2c323b; }
